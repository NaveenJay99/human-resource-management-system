<Page x:Class="HRMSystem.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HRMSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="640" d:DesignWidth="1024"
      Height="640" Width="1024"
      Title="LoginPage"
      Background="White">


    <Grid Margin="0" Height="640" >

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.4*" />
            <ColumnDefinition Width="5.6*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#00597D">
            <Grid.RowDefinitions>
                <RowDefinition Height='2*' />
                <RowDefinition Height=".6*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Rectangle Width="200" Height="200" RadiusX="20" RadiusY="20"    >
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/Assets/Logo.jpeg"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock HorizontalAlignment="Center" Grid.Row="1" Foreground="White" 
                       Margin="0,25, 0, 0" Text="Human Resource Management System" FontWeight="Bold" 
                       FontSize="22"/>
            <TextBlock Grid.Row="2" Text="Welcome to Crew Cloud Effortlessly manage employee data, track attendance, handle performance, and more all in one secure platform. Please log in to access your personalized dashboard and get started!"
                       Foreground="white" FontWeight="Light" Width="400" TextWrapping="Wrap" 
                       TextAlignment="center" FontSize="16" Margin="0,40,10,10"/>

        </Grid>

        <Grid Grid.Column="1" Background="	#D3D3D3">
            <Border Margin="20"
            Background="white"
            CornerRadius="20"
            Height="500" Width="400"
            Padding="30"
            SnapsToDevicePixels="True"
            Effect="{DynamicResource DropShadow}">
                <StackPanel>

                    <TextBlock Text="LOGIN"
                       FontSize="28" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,80,0,30"/>

                    <TextBlock Text="User Name" FontSize="14" Margin="0,0,0,5"/>
                    <DockPanel Margin="0,10,0,10">
                        <Image Source="/Assets/user.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBox Name="txtUsername"
                         BorderThickness="0,0,0,1"
                         BorderBrush="Gray"
                         Background="Transparent"
                         FontSize="14"
                         Padding="2"/>
                    </DockPanel>

                    <TextBlock Text="Password" FontSize="14" Margin="0,10,0,5"/>
                    <DockPanel Margin="0,10,0,10">
                        <Image Source="/Assets/padlock.png" Width="20" Height="20" Margin="0,0,5,0"/>
                        <PasswordBox BorderThickness="0,0,0,1"
                             BorderBrush="Gray" Name="txtPassword"
                             Background="Transparent"
                             FontSize="14"
                             Padding="2"/>
                    </DockPanel>

                    <Button Name="btnLogin" Width="250" Height="45"
                    Background="Black" 
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,20" FontSize="18"
                    Cursor="Hand" Content="LOGIN" Click = "BtnLogin_Click"/>

                  

                    <TextBlock Text="Fogot your password?" HorizontalAlignment="Center" Foreground="Gray" 
                               FontSize="14"/>
                    <TextBlock Text="Click here to reset your password"
                       HorizontalAlignment="Center"
                       Foreground="gray"
                       FontWeight="Normal"
                       FontSize="11"
                       Cursor="Hand"/>
                    
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>

