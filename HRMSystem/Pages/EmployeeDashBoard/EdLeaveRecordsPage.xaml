<Page x:Class="HRMSystem.Pages.EmployeeDashBoard.EdLeaveRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HRMSystem.Pages.EmployeeDashBoard"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
       Width="730" Height="640" Background="White"
      Title="EdLeaveRecordsPage">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="92*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Leave Records" FontSize="22" FontWeight="Bold" 
               VerticalAlignment="Center"/>

        <Grid Grid.Row="1">
            <DataGrid
                  AutoGenerateColumns="False"
                  x:Name="dataGridLeaveRecords"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  Margin="10,32,0,33"
                  Height="340"
                  Width="740" HorizontalAlignment="Left">
                <!--We have to bind data to this colums relevantly I have added these items as placeholders-->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Leave Type" Binding="{Binding LeaveType}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                    <DataGridTextColumn Header="Request Status" Binding="{Binding Status}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>


    </Grid>

</Page>
