<Page x:Class="HRMSystem.Pages.EmployeeDashBoard.EdChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HRMSystem.Pages.EmployeeDashBoard"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Width="730" Height="640" Background="White"
      Title="EdChangePasswordPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="72*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Change Password" FontSize="22" FontWeight="Bold" 
            VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Height="240" Width="700">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="20"  VerticalAlignment="Center">
                
                <TextBlock Text="Username"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#555"/>


                <TextBox Width="250" Margin="40,0,0,0" Height="32" FontSize="14" Padding="8,4"  Background="#F0F0F0"
                    BorderBrush="#CCC"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>        

            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20"  VerticalAlignment="Center">

                <TextBlock Text="Old Password"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#555"/> 


                <TextBox Width="250" Margin="40,0,0,0" Height="32" FontSize="14" Padding="8,4"  Background="#F0F0F0"
                     BorderBrush="#CCC"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"/>

            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20"  VerticalAlignment="Center">

                <TextBlock Text="New Password"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#555"/>


                <TextBox Width="250" Margin="40,0,0,0" Height="32" FontSize="14" Padding="8,4"  Background="#F0F0F0"
                     BorderBrush="#CCC"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"/>

            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="20"  VerticalAlignment="Center">

                <TextBlock Text="Confirm New Password"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#555"/>


                <TextBox Width="250" Margin="40,0,0,0" Height="32" FontSize="14" Padding="8,4"  Background="#F0F0F0"
                     BorderBrush="#CCC"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"/>       

            </StackPanel>
        </Grid>
        <Button Grid.Row="5" Width="240" Height="50" Content="Save Changes" FontSize="16"
                FontWeight="Bold"/>
    </Grid>
</Page>
