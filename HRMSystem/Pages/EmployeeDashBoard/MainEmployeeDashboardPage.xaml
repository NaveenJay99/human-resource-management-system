<Page x:Class="HRMSystem.Pages.EmployeeDashBoard.MainEmployeeDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HRMSystem.Pages.EmployeeDashBoard"
      mc:Ignorable="d" 
      d:DesignHeight="640" d:DesignWidth="1024"
      Title="MainEmployeeDashboardPage" Background="white"
      Width="1024" Height="640">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#4A8A6E">
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="8*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Employee DashBoard" Foreground="white" FontSize="30" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Grid.Row="1" Content="View my Details" Width="270" Height="64" FontSize="26"
                    Background="LightGray"/>
            <Button Grid.Row="2" Content="Attendance Records"
                Width="270" Height="64" FontSize="26"
                Background="Transparent" Foreground="White"
                 >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                            CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>  
            </Button>
        </Grid>
        


    </Grid>
</Page>
