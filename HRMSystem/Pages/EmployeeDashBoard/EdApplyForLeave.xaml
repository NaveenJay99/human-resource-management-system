<Page x:Class="HRMSystem.Pages.EmployeeDashBoard.EdApplyForLeave"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HRMSystem.Pages.EmployeeDashBoard"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Width="730" Height="640" Background="White"
      Title="EdApplyForLeave">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="56*"/>
            <RowDefinition Height="56*"/>
            <RowDefinition Height="189*"/>
            <RowDefinition Height="104*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Apply for leave" FontSize="22" FontWeight="Bold" 
            VerticalAlignment="Center" Height="29"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Height="30" >
            <TextBlock Text="Leave Date"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#555"/>
            <DatePicker x:Name="datePicker" Width="160" Height="30" Margin="60,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Height="30">
            <TextBlock Text="Leave Type"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#555"
                   Margin="0,0,10,0" Width="83"/>
            <ComboBox x:Name="comboBoxLeaveType" Width="160" Height="30"  Margin="60,0,0,0" >
                <ComboBoxItem Content="Sick Leave"/>
                <ComboBoxItem Content="Casual Leave"/>
                <ComboBoxItem Content="Annual Leave"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="20,20,20,20" >

            <!-- Section Title -->
            <TextBlock Text="Leave Details"
               FontSize="18"
               FontWeight="Normal"
               Foreground="#333" />

            <!-- Large TextBox for Details -->
            <TextBox Height="120"
             x:Name="tbLeaveDetail"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             FontSize="14"
             Padding="10"
             Background="#F0F0F0"
             BorderBrush="#CCC"
             BorderThickness="1"
             VerticalScrollBarVisibility="Auto"/>

        </StackPanel>
        <Button x:Name="btnApply" Click="btnApply_Click" Content="Apply" FontSize="16" Width="240" Grid.Row="4" HorizontalAlignment="Left" Margin="30,21,0,39"/>

    </Grid>
</Page>
