<Page x:Class="HRMS_App.Views.HRManagerMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:HRMS_App.Views"
      Background="White"
      Title="HR Manager Dashboard"
      Width="1024" Height="640">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="284"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Static Panel -->
        <StackPanel Background="white" Grid.Column="0" Margin="20">
            <TextBlock Text="HRM Dashboard" FontSize="22" FontWeight="Bold" Foreground="Black" Margin="0 0 0 20"/>

            <Button Content="Employee Management" Click="EmployeeBtn_Click" Margin="0 5" Padding="10"/>
            <Button Content="Department Management" Click="DepartmentBtn_Click" Margin="0 5" Padding="10"/>
            <Button Content="Leave Management" Click="LeaveBtn_Click" Margin="0 5" Padding="10"/>
            <Button Content="Attendance Tracking" Click="AttendanceBtn_Click" Margin="0 5" Padding="10"/>
            <Button Content="Payroll Management" Click="PayrollBtn_Click" Margin="0 5" Padding="10"/>
            <Button Content="Reporting" Click="ReportingBtn_Click" Margin="0 5" Padding="10"/>
        </StackPanel>

        <!-- Right Dynamic Section -->
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
