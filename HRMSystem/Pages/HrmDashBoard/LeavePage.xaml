<Page x:Class="HRMS_App.Views.LeavePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LeaveManagementPage"
      Background="White">

    <Grid Width="640" Height="1024" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Title -->
        <TextBlock Text="Leave Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 🔹 Main Content -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">

            <!-- 🔸 Filter -->
            <ComboBox x:Name="cmbFilter" Width="200" Height="30" Margin="0,0,0,10" SelectedIndex="0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Approved"/>
                <ComboBoxItem Content="Rejected"/>
            </ComboBox>

            <!-- 🔸 DataGrid for Leave Requests -->
            <DataGrid x:Name="dgLeaveRequests"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      Height="400"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="From" Binding="{Binding FromDate}" Width="*"/>
                    <DataGridTextColumn Header="To" Binding="{Binding ToDate}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding LeaveType}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 🔸 Buttons -->
            <WrapPanel>
                <Button x:Name="btnApprove" Content="Approve" Width="100" Margin="5"/>
                <Button x:Name="btnReject" Content="Reject" Width="100" Margin="5"/>
                <Button x:Name="btnRefresh" Content="Refresh" Width="100" Margin="5"/>
            </WrapPanel>

        </StackPanel>
    </Grid>
</Page>
