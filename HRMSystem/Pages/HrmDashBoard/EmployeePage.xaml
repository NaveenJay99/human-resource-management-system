<Page x:Class="HRMS_App.Views.EmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:HRMS_App.Views"
      Background="White"
      Title="EmployeePage">

    <Grid Background="White" Width="740" Height="640" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Title -->
        <TextBlock Text="Employee Management" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- 🔹 Form and Buttons -->
        <StackPanel Grid.Row="0" Margin="0,40,0,20">
            <WrapPanel Margin="0,5,0,5">
    <TextBox x:Name="txtEmpName" Width="120" Margin="5" />
    <TextBox x:Name="txtEmpID" Width="80" Margin="5" />
    <TextBox x:Name="txtDepartment" Width="100" Margin="5" />
    <TextBox x:Name="txtPosition" Width="100" Margin="5" />
    <TextBox x:Name="txtSalary" Width="80" Margin="5" />
    <TextBox x:Name="txtContact" Width="120" Margin="5" />
</WrapPanel>

<WrapPanel Margin="0,5,0,5">
    <Button x:Name="btnAdd" Content="Add" Width="90" Margin="5"/>
    <Button x:Name="btnUpdate" Content="Update" Width="90" Margin="5"/>
    <Button x:Name="btnDelete" Content="Delete" Width="90" Margin="5"/>
    <TextBox x:Name="txtSearch" Width="180" Margin="10,0" />
                <Button x:Name="btnSearch" Content="Search" Width="90" Margin="5"/>
            </WrapPanel>

        </StackPanel>

        <!-- 🔹 Data Grid -->
        <DataGrid x:Name="dgEmployees"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0"
                  SelectionMode="Single"
                  RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="*"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*"/>
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="*"/>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary}" Width="*"/>
                <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

